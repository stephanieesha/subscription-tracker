# Leave DATABASE_URL unset locally to keep using data/subscriptions.json.
# In production set it to a Neon/Postgres connection string.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# WRITE_LIMIT_PER_MINUTE=60
# MAX_SUBSCRIPTIONS=200

# Login (required). Generate APP_PASSWORD_HASH with the command in README.md.
# APP_USERNAME=owner
# APP_PASSWORD_HASH=scrypt:...
# SECRET_KEY=replace-with-a-long-random-string
